{
  "_nota": "Templates que sairam do lovelace.minha_casa por nao estarem em uso (auditoria de 07/09/2026). Para reativar, colar de volta em button_card_templates.",
  "templates": {
    "divider": {
      "type": "custom:button-card",
      "show_name": false,
      "show_state": false,
      "show_icon": false,
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"divider\"",
            "grid-template-columns": "1fr",
            "grid-template-rows": "1fr"
          }
        ],
        "card": [
          {
            "background-color": "transparent",
            "padding": "0px 15px 0px 15px",
            "margin": "0px"
          }
        ]
      },
      "custom_fields": {
        "divider": {
          "card": {
            "type": "entities",
            "entities": [
              {
                "type": "divider",
                "style": {
                  "height": "1px",
                  "width": "100%",
                  "margin-left": "auto",
                  "margin-right": "auto",
                  "background": "rgba(255,255,255,0.1)"
                }
              }
            ],
            "card_mod": {
              "style": "ha-card { background: transparent; }\n#states.card-content { padding: 0px; }"
            }
          }
        }
      }
    },
    "heading": {
      "variables": {
        "var_name": null
      },
      "type": "custom:button-card",
      "name": "[[[ return variables.var_name ]]]",
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"n\"",
            "align-self": "start",
            "justify-self": "start"
          }
        ],
        "card": [
          {
            "background-color": "transparent",
            "padding": "10px 0px 0px 5px",
            "margin": "0px"
          }
        ],
        "name": [
          {
            "font-size": "20px",
            "font-weight": "700",
            "color": "white",
            "justify-self": "start"
          }
        ]
      }
    },
    "room_row": {
      "variables": {
        "var_name": null,
        "var_icon": "mdi:sofa",
        "var_light": null,
        "var_color": "#0A84FF",
        "var_path": "/",
        "var_light_list": null
      },
      "type": "custom:button-card",
      "entity": "[[[ return variables.var_light ]]]",
      "name": "[[[ return variables.var_name ]]]",
      "icon": "[[[ return variables.var_icon ]]]",
      "show_name": true,
      "show_icon": true,
      "show_state": false,
      "tap_action": {
        "action": "navigate",
        "navigation_path": "[[[ return variables.var_path ]]]"
      },
      "custom_fields": {
        "toggle": {
          "card": {
            "type": "custom:button-card",
            "entity": "[[[ return variables.var_light ]]]",
            "icon": "mdi:power",
            "show_name": false,
            "show_state": false,
            "show_icon": true,
            "tap_action": {
              "action": "toggle"
            },
            "state": [
              {
                "value": "off",
                "styles": {
                  "card": [
                    {
                      "background-color": "transparent",
                      "background": "transparent"
                    }
                  ],
                  "icon": [
                    {
                      "color": "rgba(255,255,255,0.35)"
                    }
                  ]
                }
              },
              {
                "value": "on",
                "styles": {
                  "card": [
                    {
                      "background": "#FF9F0A"
                    }
                  ],
                  "icon": [
                    {
                      "color": "white"
                    }
                  ]
                }
              }
            ],
            "styles": {
              "card": [
                {
                  "width": "32px",
                  "height": "32px",
                  "border-radius": "100%",
                  "padding": "0px"
                }
              ],
              "icon": [
                {
                  "width": "15px"
                }
              ],
              "grid": [
                {
                  "grid-template-rows": "1fr",
                  "align-items": "center",
                  "align-content": "center"
                }
              ]
            },
            "card_mod": {
              "style": "ha-card {\n  backdrop-filter: blur(10px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(10px) saturate(160%) !important;\n}\n"
            }
          }
        }
      },
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"i n toggle\"",
            "grid-template-columns": "40px 1fr min-content"
          }
        ],
        "card": [
          {
            "background": "transparent",
            "padding": "8px 4px",
            "border-radius": "0px",
            "display": "[[[ const list = variables.var_light_list; if (!list) return 'block'; return list.some(e => states[e] && states[e].state === 'on') ? 'block' : 'none'; ]]]"
          }
        ],
        "name": [
          {
            "font-weight": "550",
            "font-size": "15px",
            "justify-self": "start",
            "color": "white",
            "letter-spacing": "-0.01em"
          }
        ],
        "img_cell": [
          {
            "width": "30px",
            "height": "30px",
            "border-radius": "12px",
            "background-color": "[[[ return variables.var_color ]]]",
            "margin-right": "6px"
          }
        ],
        "icon": [
          {
            "width": "16px",
            "color": "white"
          }
        ],
        "custom_fields": {
          "toggle": [
            {
              "justify-self": "end",
              "align-self": "center"
            }
          ]
        }
      }
    },
    "weather_widget": {
      "type": "custom:button-card",
      "entity": "weather.forecast_casa",
      "show_name": false,
      "show_icon": true,
      "show_state": false,
      "tap_action": {
        "action": "more-info"
      },
      "custom_fields": {
        "temp": {
          "card": {
            "type": "custom:button-card",
            "show_name": true,
            "show_icon": false,
            "name": "[[[ return Math.round(states['weather.forecast_casa'].attributes.temperature) + '°'; ]]]",
            "styles": {
              "card": [
                {
                  "background": "transparent",
                  "padding": "0px",
                  "height": "auto"
                }
              ],
              "name": [
                {
                  "font-size": "48px",
                  "font-weight": "600",
                  "color": "white"
                }
              ]
            }
          }
        },
        "cond": {
          "card": {
            "type": "custom:button-card",
            "show_name": true,
            "show_icon": false,
            "name": "[[[ return states['weather.forecast_casa'].state; ]]]",
            "styles": {
              "card": [
                {
                  "background": "transparent",
                  "padding": "0px"
                }
              ],
              "name": [
                {
                  "font-size": "15px",
                  "color": "rgba(255,255,255,0.7)",
                  "text-transform": "capitalize"
                }
              ]
            }
          }
        }
      },
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"icon temp\" \"icon cond\"",
            "grid-template-columns": "min-content 1fr"
          }
        ],
        "card": [
          {
            "background": "transparent",
            "height": "130px",
            "padding": "10px"
          }
        ],
        "icon": [
          {
            "width": "72px",
            "color": "white"
          }
        ],
        "custom_fields": {
          "temp": [
            {
              "justify-self": "start"
            }
          ],
          "cond": [
            {
              "justify-self": "start"
            }
          ]
        }
      }
    },
    "device_tile": {
      "variables": {
        "var_name": null,
        "var_icon": "mdi:lightbulb",
        "var_color": "#FF9F0A"
      },
      "type": "custom:button-card",
      "name": "[[[ return variables.var_name ]]]",
      "icon": "[[[ return variables.var_icon ]]]",
      "show_name": true,
      "show_icon": true,
      "show_state": true,
      "tap_action": {
        "action": "toggle"
      },
      "hold_action": {
        "action": "more-info"
      },
      "state": [
        {
          "value": "off",
          "styles": {
            "card": [
              {
                "background": "transparent"
              }
            ],
            "icon": [
              {
                "color": "rgba(255,255,255,0.35)"
              }
            ],
            "name": [
              {
                "color": "rgba(255,255,255,0.6)"
              }
            ],
            "state": [
              {
                "color": "rgba(255,255,255,0.4)"
              }
            ]
          }
        },
        {
          "value": "on",
          "styles": {
            "card": [
              {
                "background": "[[[ return variables.var_color ]]]"
              }
            ],
            "icon": [
              {
                "color": "white"
              }
            ],
            "name": [
              {
                "color": "white"
              }
            ],
            "state": [
              {
                "color": "rgba(255,255,255,0.85)"
              }
            ]
          }
        }
      ],
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"i\" \"n\" \"s\"",
            "grid-template-rows": "min-content min-content min-content"
          }
        ],
        "card": [
          {
            "border-radius": "20px",
            "height": "108px",
            "padding": "14px",
            "justify-content": "start",
            "justify-items": "start",
            "border": "1px solid rgba(255,255,255,0.1)"
          }
        ],
        "icon": [
          {
            "width": "26px"
          }
        ],
        "name": [
          {
            "font-size": "14px",
            "font-weight": "550",
            "padding-top": "10px",
            "justify-self": "start",
            "letter-spacing": "-0.01em"
          }
        ],
        "state": [
          {
            "font-size": "12px",
            "justify-self": "start"
          }
        ]
      },
      "card_mod": {
        "style": "ha-card {\n  backdrop-filter: blur(20px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(20px) saturate(160%) !important;\n}\n"
      }
    },
    "room_tile": {
      "variables": {
        "var_name": null,
        "var_path": "/",
        "var_motion": null,
        "var_temp": null,
        "var_sensor": null,
        "var_lights": []
      },
      "type": "custom:button-card",
      "entity": "[[[ return variables.var_motion ]]]",
      "name": "[[[ return variables.var_name ]]]",
      "show_icon": false,
      "show_name": true,
      "show_state": false,
      "tap_action": {
        "action": "navigate",
        "navigation_path": "[[[ return variables.var_path ]]]"
      },
      "custom_fields": {
        "one": {
          "card": {
            "type": "custom:button-card",
            "entity": "[[[ return variables.var_sensor ]]]",
            "icon": "mdi:lightbulb",
            "show_name": false,
            "show_state": true,
            "show_icon": true,
            "tap_action": {
              "action": "call-service",
              "service": "[[[ const l = variables.var_lights || []; const algumaAcesa = l.some(e => states[e] && states[e].state === 'on'); return algumaAcesa ? 'homeassistant.turn_off' : 'homeassistant.turn_on'; ]]]",
              "data": {
                "entity_id": "[[[ return variables.var_lights ]]]"
              }
            },
            "state": [
              {
                "value": "0",
                "styles": {
                  "card": [
                    {
                      "background-color": "rgba(255,255,255,0.10)"
                    }
                  ],
                  "icon": [
                    {
                      "color": "rgba(255,255,255,0.45)"
                    }
                  ]
                }
              },
              {
                "value": "unavailable",
                "styles": {
                  "card": [
                    {
                      "background": "transparent"
                    }
                  ],
                  "icon": [
                    {
                      "color": "transparent"
                    }
                  ],
                  "state": [
                    {
                      "color": "transparent"
                    }
                  ]
                }
              }
            ],
            "styles": {
              "grid": [
                {
                  "grid-template-areas": "\"i s\"",
                  "align-items": "center",
                  "grid-template-columns": "14px 1fr",
                  "gap": "3px",
                  "grid-template-rows": "1fr",
                  "align-content": "center",
                  "justify-content": "center"
                }
              ],
              "icon": [
                {
                  "width": "12px",
                  "color": "white",
                  "padding-left": "2px"
                }
              ],
              "state": [
                {
                  "color": "white",
                  "font-size": "12px",
                  "justify-self": "start",
                  "padding-right": "5px",
                  "font-weight": "600"
                }
              ],
              "card": [
                {
                  "height": "25px",
                  "width": "42px",
                  "background-color": "#ff9800",
                  "padding": "0px 4px",
                  "border-radius": "6px",
                  "display": "[[[ return variables.var_sensor ? 'grid' : 'none' ]]]"
                }
              ],
              "img_cell": [
                {
                  "width": "14px",
                  "height": "14px"
                }
              ]
            },
            "card_mod": {
              "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
            }
          }
        },
        "two": {
          "card": {
            "type": "custom:button-card",
            "entity": "[[[ return variables.var_motion ]]]",
            "icon": "mdi:motion-sensor-off",
            "show_name": false,
            "show_state": false,
            "show_icon": true,
            "state": [
              {
                "value": "on",
                "icon": "mdi:motion-sensor",
                "styles": {
                  "card": [
                    {
                      "background-color": "rgba(255,255,255,0.22)"
                    }
                  ],
                  "icon": [
                    {
                      "color": "rgba(255,255,255,0.9)"
                    }
                  ]
                }
              },
              {
                "value": "unavailable",
                "styles": {
                  "card": [
                    {
                      "background": "transparent"
                    }
                  ],
                  "icon": [
                    {
                      "color": "transparent"
                    }
                  ]
                }
              }
            ],
            "styles": {
              "icon": [
                {
                  "width": "12px",
                  "color": "rgba(255,255,255,0.45)"
                }
              ],
              "card": [
                {
                  "height": "25px",
                  "width": "25px",
                  "background-color": "rgba(255,255,255,0.10)",
                  "padding": "0px",
                  "border-radius": "6px",
                  "display": "[[[ return variables.var_motion ? 'grid' : 'none' ]]]"
                }
              ],
              "img_cell": [
                {
                  "width": "14px",
                  "height": "14px"
                }
              ],
              "grid": [
                {
                  "grid-template-rows": "1fr",
                  "align-items": "center",
                  "align-content": "center",
                  "justify-content": "center"
                }
              ]
            },
            "card_mod": {
              "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
            }
          }
        },
        "three": {
          "card": {
            "type": "custom:button-card",
            "entity": "[[[ return variables.var_temp ]]]",
            "show_name": false,
            "show_state": true,
            "show_icon": false,
            "state": [
              {
                "value": 15,
                "operator": "<",
                "styles": {
                  "card": [
                    {
                      "background": "var(--label-badge-green)"
                    }
                  ]
                }
              },
              {
                "value": 20,
                "operator": "<=",
                "styles": {
                  "card": [
                    {
                      "background": "var(--label-badge-blue)"
                    }
                  ]
                }
              },
              {
                "value": 25,
                "operator": "<=",
                "styles": {
                  "card": [
                    {
                      "background": "var(--label-badge-red)"
                    }
                  ]
                }
              },
              {
                "value": 30,
                "operator": "<=",
                "styles": {
                  "card": [
                    {
                      "background": "#a357d7"
                    }
                  ]
                }
              },
              {
                "value": 35,
                "operator": "<=",
                "styles": {
                  "card": [
                    {
                      "background": "#f7ce46"
                    }
                  ]
                }
              },
              {
                "value": "unavailable",
                "styles": {
                  "card": [
                    {
                      "background": "transparent"
                    }
                  ],
                  "state": [
                    {
                      "color": "transparent"
                    }
                  ]
                }
              }
            ],
            "styles": {
              "state": [
                {
                  "color": "white",
                  "font-size": "12px",
                  "font-weight": "600"
                }
              ],
              "card": [
                {
                  "height": "25px",
                  "width": "65px",
                  "background-color": "rgba(255,255,255,0.10)",
                  "padding": "0px",
                  "border-radius": "6px",
                  "display": "[[[ return variables.var_temp ? 'grid' : 'none' ]]]"
                }
              ],
              "grid": [
                {
                  "grid-template-rows": "1fr",
                  "align-items": "center",
                  "align-content": "center",
                  "justify-content": "center"
                }
              ]
            },
            "card_mod": {
              "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
            }
          }
        }
      },
      "state": [
        {
          "value": "on",
          "styles": {
            "card": [
              {
                "opacity": "1"
              }
            ]
          }
        }
      ],
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"n n n\" \"one two three\"",
            "grid-template-columns": "min-content min-content 1fr",
            "grid-template-rows": "1fr min-content",
            "gap": "6px"
          }
        ],
        "card": [
          {
            "padding": "13px 16px 14px 16px",
            "height": "102px",
            "align-content": "end",
            "opacity": "[[[ return variables.var_motion ? '0.75' : '1' ]]]",
            "border-radius": "22px"
          }
        ],
        "name": [
          {
            "font-size": "22px",
            "font-weight": "bold",
            "justify-self": "start",
            "align-self": "start",
            "padding-top": "5px",
            "color": "white",
            "white-space": "nowrap"
          }
        ],
        "custom_fields": {
          "one": [
            {
              "justify-self": "start",
              "align-self": "end"
            }
          ],
          "two": [
            {
              "justify-self": "start",
              "align-self": "end"
            }
          ],
          "three": [
            {
              "justify-self": "start",
              "align-self": "end"
            }
          ]
        }
      },
      "card_mod": null
    },
    "panel_tile": {
      "variables": {
        "var_name": null,
        "var_icon": "mdi:card-outline",
        "var_color": "#0A84FF",
        "var_label": "",
        "var_tap": null
      },
      "type": "custom:button-card",
      "name": "[[[ return variables.var_name ]]]",
      "icon": "[[[ return variables.var_icon ]]]",
      "show_name": true,
      "show_icon": true,
      "show_state": false,
      "show_label": true,
      "label": "[[[ return variables.var_label ]]]",
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"i\" \"n\" \"l\"",
            "grid-template-rows": "1fr min-content min-content",
            "gap": "2px"
          }
        ],
        "card": [
          {
            "height": "140px",
            "padding": "14px",
            "justify-content": "start",
            "justify-items": "start"
          }
        ],
        "img_cell": [
          {
            "justify-self": "start",
            "width": "34px",
            "height": "34px"
          }
        ],
        "icon": [
          {
            "width": "28px",
            "color": "[[[ return variables.var_color ]]]"
          }
        ],
        "name": [
          {
            "justify-self": "start",
            "font-size": "14px",
            "font-weight": "550",
            "color": "white",
            "padding-top": "8px",
            "white-space": "normal",
            "line-height": "1.15",
            "text-align": "left"
          }
        ],
        "label": [
          {
            "justify-self": "start",
            "font-size": "13px",
            "font-weight": "400",
            "color": "rgba(255,255,255,0.5)",
            "white-space": "normal",
            "text-align": "left",
            "line-height": "1.15"
          }
        ]
      }
    }
  }
}
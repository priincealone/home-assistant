apple_home:
  # Base palette
  primary-color: "#0A84FF"
  accent-color: "#0A84FF"
  primary-background-color: "#0A1128"
  secondary-background-color: "#151B36"
  primary-text-color: "#FFFFFF"
  secondary-text-color: "#98989D"
  divider-color: "rgba(255, 255, 255, 0.08)"

  # App bar
  app-header-background-color: "rgba(5, 6, 15, 0.55)"
  app-header-text-color: "#FFFFFF"
  sidebar-background-color: "rgba(5, 6, 15, 0.55)"
  sidebar-text-color: "#FFFFFF"
  sidebar-selected-background-color: "rgba(10, 132, 255, 0.15)"
  sidebar-selected-text-color: "#0A84FF"
  sidebar-icon-color: "#98989D"
  sidebar-selected-icon-color: "#0A84FF"

  # Typography
  paper-font-common-base_-_font-family: >-
    -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
    "Helvetica Neue", Arial, sans-serif
  ha-card-header-font-size: "22px"
  ha-card-header-font-weight: "700"

  # Card shape
  ha-card-border-radius: "26px"
  ha-card-border-width: "0px"
  ha-card-box-shadow: "0 10px 30px rgba(0, 0, 0, 0.45)"
  ha-card-background: "rgba(24, 30, 56, 0.62)"

  mdc-theme-primary: "#0A84FF"
  mdc-theme-surface: "#151B36"
  card-background-color: "#151B36"
  dialog-background-color: "#151B36"
  dialog-surface-background: "#151B36"

  # Form fields / dropdowns inside dialogs (Título, Ícone, etc.)
  mdc-text-field-fill-color: "#1D2547"
  mdc-text-field-ink-color: "#FFFFFF"
  mdc-text-field-label-ink-color: "#98989D"
  mdc-text-field-idle-line-color: "rgba(255,255,255,0.3)"
  mdc-text-field-hover-line-color: "rgba(255,255,255,0.5)"
  mdc-select-fill-color: "#1D2547"
  mdc-select-ink-color: "#FFFFFF"
  mdc-select-label-ink-color: "#98989D"
  input-fill-color: "#1D2547"
  input-ink-color: "#FFFFFF"
  input-label-ink-color: "#98989D"
  input-idle-line-color: "rgba(255,255,255,0.3)"
  input-hover-line-color: "rgba(255,255,255,0.5)"
  primary-text-color-light-bg: "#1D2547"
  text-primary-color: "#FFFFFF"

  # card-mod: global glass + rounded style applied to every card
  card-mod-theme: "apple_home"
  card-mod-root: |
    body {
      background: radial-gradient(circle at 20% -10%, #1e2a5e 0%, #0a1128 45%, #05060f 100%) !important;
      background-attachment: fixed !important;

      /* Web Awesome (wa-*) form field colors — fixes white-on-white in dialogs */
      --wa-color-neutral-fill-quiet: #1D2547 !important;
      --wa-color-neutral-fill-normal: #1D2547 !important;
      --wa-color-neutral-fill-loud: #2A3363 !important;
      --wa-color-neutral-on-quiet: #FFFFFF !important;
      --wa-color-neutral-on-normal: #FFFFFF !important;
      --wa-color-neutral-on-loud: #FFFFFF !important;
      --wa-color-neutral-border-quiet: rgba(255,255,255,0.2) !important;
      --wa-color-neutral-border-normal: rgba(255,255,255,0.3) !important;
      --wa-color-neutral-border-loud: rgba(255,255,255,0.45) !important;
      --wa-form-control-background-color: #1D2547 !important;
      --wa-form-control-value-color: #FFFFFF !important;
      --wa-form-control-border-color: rgba(255,255,255,0.25) !important;
      --wa-form-control-placeholder-color: #8E8E93 !important;
      --wa-color-surface-default: #151B36 !important;
      --wa-color-surface-raised: #1D2547 !important;
      --wa-color-surface-lowered: #0A1128 !important;
    }

    /* Sidebar as liquid glass */
    ha-sidebar {
      background: rgba(5, 6, 15, 0.55) !important;
      backdrop-filter: blur(30px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(30px) saturate(180%) !important;
      border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    /* Top header / tab bar as liquid glass */
    .header {
      background: rgba(5, 6, 15, 0.55) !important;
      backdrop-filter: blur(30px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(30px) saturate(180%) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
  card-mod-card: |
    ha-card {
      border-radius: 30px !important;
      backdrop-filter: blur(36px) saturate(180%) brightness(1.08);
      -webkit-backdrop-filter: blur(36px) saturate(180%) brightness(1.08);
      box-shadow:
        0 12px 34px rgba(0, 0, 0, 0.4),
        0 2px 8px rgba(0, 0, 0, 0.25),
        inset 0 1px 1px rgba(255, 255, 255, 0.22),
        inset 0 -1px 1px rgba(0, 0, 0, 0.18),
        inset 0 0 0 1px rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.16);
      position: relative;
      overflow: hidden;
      transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
                  box-shadow 0.32s ease,
                  border-color 0.32s ease;
    }
    /* Diagonal specular sheen — light catching the glass surface */
    ha-card::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(135deg,
        rgba(255,255,255,0.22) 0%,
        rgba(255,255,255,0.06) 22%,
        rgba(255,255,255,0.0) 45%,
        rgba(255,255,255,0.0) 70%,
        rgba(255,255,255,0.05) 100%);
      pointer-events: none;
      z-index: 0;
    }
    /* Top edge highlight — where light bends over the rim */
    ha-card::after {
      content: "";
      position: absolute;
      top: 0; left: 8%; right: 8%;
      height: 1px;
      border-radius: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.55), transparent);
      pointer-events: none;
      z-index: 1;
    }
    ha-card > * {
      position: relative;
      z-index: 1;
    }
    ha-card:hover {
      border-color: rgba(255, 255, 255, 0.26);
      box-shadow:
        0 16px 40px rgba(0, 0, 0, 0.42),
        0 2px 8px rgba(0, 0, 0, 0.25),
        inset 0 1px 1px rgba(255, 255, 255, 0.28),
        inset 0 -1px 1px rgba(0, 0, 0, 0.18);
    }
    ha-card:active {
      transform: scale(0.965);
      box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.4),
        inset 0 1px 2px rgba(255, 255, 255, 0.3);
    }

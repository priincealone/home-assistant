            "num": "[[[ if (!entity) return ''; if (entity.state === 'on') {   return entity.attributes.brightness     ? Math.round(entity.attributes.brightness / 2.55) + '%' : 'On'; } return 'Off'; ]]]",
            "btn": {
              "card": {
                "type": "custom:button-card",
                "icon": "[[[ return variables.var_icon ]]]",

        "room_mini": {
          "variables": {
            "var_name": null,
            "var_sensor": null,
            "var_lights": [],
            "var_path": "/",
            "var_icon": "mdi:lightbulb",
            "var_color": "#FF9F0A"
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_sensor ]]]",
          "name": "[[[ return variables.var_name ]]]",
          "show_state": false,
          "show_icon": false,
          "show_name": true,
          "tap_action": {
            "action": "navigate",
            "navigation_path": "[[[ return variables.var_path ]]]"
          },
          "custom_fields": {
            "num": "[[[ if (!variables.var_sensor) return 'Sem luzes'; const n = entity ? parseInt(entity.state) : 0; if (isNaN(n)) return '--'; if (n === 0) return 'Apagado'; return n === 1 ? '1 acesa' : n + ' acesas'; ]]]",
            "btn": {
              "card": {
                "type": "custom:button-card",
                "icon": "[[[ return variables.var_icon ]]]",
                "entity": "[[[ return variables.var_sensor ]]]",
                "show_name": false,
                "show_state": false,
                "tap_action": {
                  "action": "call-service",
                  "service": "[[[ const l = variables.var_lights || []; const algumaAcesa = l.some(e => states[e] && states[e].state === 'on'); return algumaAcesa ? 'homeassistant.turn_off' : 'homeassistant.turn_on'; ]]]",
                  "data": {
                    "entity_id": "[[[ return variables.var_lights ]]]"
                  }
                },
                "state": [
                  {
                    "operator": ">",
                    "value": 0,
                    "styles": {
                      "img_cell": [
                        {
                          "background": "[[[ return variables.var_color ]]]"
                        }
                      ],
                      "icon": [
                        {
                          "color": "white"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "grid": [
                    {
                      "grid-template-areas": "\"i\"",
                      "grid-template-columns": "36px",
                      "grid-template-rows": "1fr",
                      "align-items": "center",
                      "align-content": "center",
                      "justify-items": "start"
                    }
                  ],
                  "icon": [
                    {
                      "width": "23px",
                      "color": "[[[ return variables.var_color ]]]"
                    }
                  ],
                  "img_cell": [
                    {
                      "justify-self": "start",
                      "background": "rgba(255,255,255,0.12)",
                      "border-radius": "50px",
                      "width": "36px",
                      "height": "36px"
                    }
                  ],
                  "card": [
                    {
                      "padding": "0px 6px 0px 10px",
                      "width": "52px",
                      "height": "56px",
                      "border-radius": "0px",
                      "background": "rgba(0,0,0,0)",
                      "box-shadow": "none"
                    }
                  ]
                },
                "card_mod": {
                  "style": "ha-card { background: transparent !important; border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }\n"
                }
              }
            }
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"btn n\" \"btn num\"",
                "grid-template-columns": "min-content 1fr",
                "grid-template-rows": "1fr 1fr",
                "align-items": "center"
              }
            ],
            "name": [
              {
                "justify-self": "start",
                "align-self": "end",
                "font-size": "13.5px",
                "font-weight": "550",
                "line-height": "1.25",
                "color": "white",
                "white-space": "nowrap",
                "overflow": "hidden",
                "text-overflow": "ellipsis",
                "max-width": "100%"
              }
            ],
            "custom_fields": {
              "num": [
                {
                  "color": "rgba(255,255,255,0.5)",
                  "justify-self": "start",
                  "align-self": "start",
                  "font-size": "13.5px",
                  "line-height": "1.25",
                  "font-weight": "400"
                }
              ]
            },
            "card": [
              {
                "padding": "0px 0px 0px 2px",
                "border-radius": "22px",
                "height": "70px"
              }
            ]
          },
          "card_mod": null
        }
      },
      "views": [
        {
          "title": "Geral",
          "path": "geral",
          "icon": "mdi:view-dashboard",
          "cards": [
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "show_icon": false,
                      "show_state": false,
                      "show_name": true,
                      "show_label": true,
                      "tap_action": {
                        "action": "none"
                      },
                      "name": "[[[ const h = new Date().getHours(); const s = h < 12 ? 'Bom dia' : (h < 18 ? 'Boa tarde' : 'Boa noite'); return s + ', André'; ]]]",
                      "label": "[[[ const d = new Date(); const dias = ['domingo','segunda-feira','terça-feira','quarta-feira','quinta-feira','sexta-feira','sábado']; const meses = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']; return dias[d.getDay()] + ', ' + d.getDate() + ' de ' + meses[d.getMonth()]; ]]]",
                      "styles": {
                        "grid": [
                          {
                            "grid-template-areas": "\"n\" \"l\"",
                            "grid-template-rows": "min-content min-content",
                            "gap": "2px"
                          }
                        ],
                        "card": [
                          {
                            "background": "transparent",
                            "box-shadow": "none",
                            "padding": "4px 8px",
                            "justify-content": "start"
                          }
                        ],
                        "name": [
                          {
                            "justify-self": "start",
                            "font-size": "32px",
                            "font-weight": "bold",
                            "color": "white",
                            "filter": "drop-shadow(rgba(0,0,0,0.5) 0.1rem 0.1rem 2px)"
                          }
                        ],
                        "label": [
                          {
                            "justify-self": "start",
                            "font-size": "15px",
                            "font-weight": "400",
                            "color": "rgba(255,255,255,0.65)",
                            "white-space": "nowrap"
                          }
                        ]
                      },
                      "card_mod": {
                        "style": "ha-card { background: transparent !important; border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }\n@media (max-width: 700px) {\n  #name { font-size: 24px !important; }\n  #label { font-size: 12px !important; }\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-chips-card",
                      "alignment": "center",
                      "chips": [
                        {
                          "type": "weather",
                          "entity": "weather.forecast_casa",
                          "show_temperature": true,
                          "show_conditions": true
                        },
                        {
                          "type": "entity",
                          "entity": "person.andre"
                        },
                        {
                          "type": "template",
                          "icon": "mdi:lightbulb-on",
                          "icon_color": "amber",
                          "content": "{{ states('sensor.luzes_acesas_total') }} luzes",
                          "tap_action": {
                            "action": "navigate",
                            "navigation_path": "/minha-casa/luzes"
                          }
                        },
                        {
                          "type": "template",
                          "entity": "binary_sensor.pc_andre",
                          "icon": "mdi:desktop-tower-monitor",
                          "icon_color": "{{ 'green' if is_state('binary_sensor.pc_andre','on') else 'grey' }}",
                          "content": "{{ 'Conectado' if is_state('binary_sensor.pc_andre','on') else 'Offline' }}",
                          "tap_action": {
                            "action": "fire-dom-event",
                            "browser_mod": {
                              "service": "popup",
                              "data": {
                                "title": "PC do André",
                                "content": {
                                  "type": "vertical-stack",

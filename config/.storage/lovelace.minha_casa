                      "card": [
                        {
                          "background-color": "rgba(255,255,255,0.22)"
                        }
                      ],
                      "icon": [
                        {
                          "color": "rgba(255,255,255,0.9)"
                        }
                      ]
                    }
                  },
                  {
                    "value": "unavailable",
                    "styles": {
                      "card": [
                        {
                          "background": "transparent"
                        }
                      ],
                      "icon": [
                        {
                          "color": "transparent"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "icon": [
                    {
                      "width": "12px",
                      "color": "rgba(255,255,255,0.45)"
                    }
                  ],
                  "card": [
                    {
                      "height": "25px",
                      "width": "25px",
                      "background-color": "rgba(255,255,255,0.10)",
                      "padding": "0px",
                      "border-radius": "6px",
                      "display": "[[[ return variables.var_motion ? 'grid' : 'none' ]]]"
                    }
                  ],
                  "img_cell": [
                    {
                      "width": "14px",
                      "height": "14px"
                    }
                  ],
                  "grid": [
                    {
                      "grid-template-rows": "1fr",
                      "align-items": "center",
                      "align-content": "center",
                      "justify-content": "center"
                    }
                  ]
                },
                "card_mod": {
                  "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
                }
              }
            },
            "three": {
              "card": {
                "type": "custom:button-card",
                "entity": "[[[ return variables.var_temp ]]]",
                "show_name": false,
                "show_state": true,
                "show_icon": false,
                "state": [
                  {
                    "value": 15,
                    "operator": "<",
                    "styles": {
                      "card": [
                        {
                          "background": "var(--label-badge-green)"
                        }
                      ]
                    }
                  },
                  {
                    "value": 20,
                    "operator": "<=",
                    "styles": {
                      "card": [
                        {
                          "background": "var(--label-badge-blue)"
                        }
                      ]
                    }
                  },
                  {
                    "value": 25,
                    "operator": "<=",
                    "styles": {
                      "card": [
                        {
                          "background": "var(--label-badge-red)"
                        }
                      ]
                    }
                  },
                  {
                    "value": 30,
                    "operator": "<=",
                    "styles": {
                      "card": [
                        {
                          "background": "#a357d7"
                        }
                      ]
                    }
                  },
                  {
                    "value": 35,
                    "operator": "<=",
                    "styles": {
                      "card": [
                        {
                          "background": "#f7ce46"
                        }
                      ]
                    }
                  },
                  {
                    "value": "unavailable",
                    "styles": {
                      "card": [
                        {
                          "background": "transparent"
                        }
                      ],
                      "state": [
                        {
                          "color": "transparent"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "state": [
                    {
                      "color": "white",
                      "font-size": "12px",
                      "font-weight": "600"
                    }
                  ],
                  "card": [
                    {
                      "height": "25px",
                      "width": "65px",
                      "background-color": "rgba(255,255,255,0.10)",
                      "padding": "0px",
                      "border-radius": "6px",
                      "display": "[[[ return variables.var_temp ? 'grid' : 'none' ]]]"
                    }
                  ],
                  "grid": [
                    {
                      "grid-template-rows": "1fr",
                      "align-items": "center",
                      "align-content": "center",
                      "justify-content": "center"
                    }
                  ]
                },
                "card_mod": {
                  "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
                }
              }
            }
          },
          "state": [
            {
              "value": "on",
              "styles": {
                "card": [
                  {
                    "opacity": "1"
                  }
                ]
              }
            }
          ],
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"n n n\" \"one two three\"",
                "grid-template-columns": "min-content min-content 1fr",
                "grid-template-rows": "1fr min-content",
                "gap": "6px"
              }
            ],
            "card": [
              {
                "padding": "13px 16px 14px 16px",
                "height": "102px",
                "align-content": "end",
                "opacity": "[[[ return variables.var_motion ? '0.75' : '1' ]]]",
                "border-radius": "22px"
              }
            ],
            "name": [
              {
                "font-size": "22px",
                "font-weight": "bold",
                "justify-self": "start",
                "align-self": "start",
                "padding-top": "5px",
                "color": "white",
                "white-space": "nowrap"
              }
            ],
            "custom_fields": {
              "one": [
                {
                  "justify-self": "start",
                  "align-self": "end"
                }
              ],
              "two": [
                {
                  "justify-self": "start",
                  "align-self": "end"
                }
              ],
              "three": [
                {
                  "justify-self": "start",
                  "align-self": "end"
                }
              ]
            }
          },
          "card_mod": null
        },
        "room_header": {
          "variables": {
            "var_name": "name"
          },
          "type": "custom:button-card",

{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.minha_casa",
  "data": {
    "config": {
      "button_card_templates": {
        "divider": {
          "type": "custom:button-card",
          "show_name": false,
          "show_state": false,
          "show_icon": false,
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"divider\"",
                "grid-template-columns": "1fr",
                "grid-template-rows": "1fr"
              }
            ],
            "card": [
              {
                "background-color": "transparent",
                "padding": "0px 15px 0px 15px",
                "margin": "0px"
              }
            ]
          },
          "custom_fields": {
            "divider": {
              "card": {
                "type": "entities",
                "entities": [
                  {
                    "type": "divider",
                    "style": {
                      "height": "1px",
                      "width": "100%",
                      "margin-left": "auto",
                      "margin-right": "auto",
                      "background": "rgba(255,255,255,0.1)"
                    }
                  }
                ],
                "card_mod": {
                  "style": "ha-card { background: transparent; }\n#states.card-content { padding: 0px; }"
                }
              }
            }
          }
        },
        "heading": {
          "variables": {
            "var_name": null
          },
          "type": "custom:button-card",
          "name": "[[[ return variables.var_name ]]]",
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"n\"",
                "align-self": "start",
                "justify-self": "start"
              }
            ],
            "card": [
              {
                "background-color": "transparent",
                "padding": "10px 0px 0px 5px",
                "margin": "0px"
              }
            ],
            "name": [
              {
                "font-size": "20px",
                "font-weight": "700",
                "color": "white",
                "justify-self": "start"
              }
            ]
          }
        },
        "apple_scene": {
          "variables": {
            "var_name": null,
            "var_scene": null,
            "var_icon": null,
            "var_icon_color": "white"
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_scene ]]]",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "[[[ return variables.var_icon ]]]",
          "tap_action": {
            "action": "toggle"
          },
          "hold_action": {
            "action": "more-info"
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i n\"",
                "grid-template-columns": "24px 1fr",
                "grid-template-rows": "1fr",
                "align-items": "center",
                "align-content": "center",
                "gap": "10px"
              }
            ],
            "card": [
              {
                "background-color": "rgba(255,255,255,0.06)",
                "border-radius": "18px",
                "height": "56px",
                "padding": "0px 14px"
              }
            ],
            "name": [
              {
                "justify-self": "start",
                "font-size": "14px",
                "font-weight": "600",
                "color": "white"
              }
            ],
            "icon": [
              {
                "width": "21px",
                "height": "21px",
                "color": "[[[ return variables.var_icon_color ]]]"
              }
            ],
            "img_cell": [
              {
                "width": "24px",
                "height": "24px",
                "justify-self": "start",
                "align-self": "center"
              }
            ]
          },
          "show_state": false
        },
        "room_row": {
          "variables": {
            "var_name": null,
            "var_icon": "mdi:sofa",
            "var_light": null,
            "var_color": "#0A84FF",
            "var_path": "/",
            "var_light_list": null
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_light ]]]",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "[[[ return variables.var_icon ]]]",
          "show_name": true,
          "show_icon": true,
          "show_state": false,
          "tap_action": {
            "action": "navigate",
            "navigation_path": "[[[ return variables.var_path ]]]"
          },
          "custom_fields": {
            "toggle": {
              "card": {
                "type": "custom:button-card",
                "entity": "[[[ return variables.var_light ]]]",
                "icon": "mdi:power",
                "show_name": false,
                "show_state": false,
                "show_icon": true,
                "tap_action": {
                  "action": "toggle"
                },
                "state": [
                  {
                    "value": "off",
                    "styles": {
                      "card": [
                        {
                          "background-color": "transparent",
                          "background": "transparent"
                        }
                      ],
                      "icon": [
                        {
                          "color": "rgba(255,255,255,0.35)"
                        }
                      ]
                    }
                  },
                  {
                    "value": "on",
                    "styles": {
                      "card": [
                        {
                          "background": "#FF9F0A"
                        }
                      ],
                      "icon": [
                        {
                          "color": "white"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "card": [
                    {
                      "width": "32px",
                      "height": "32px",
                      "border-radius": "100%",
                      "padding": "0px"
                    }
                  ],
                  "icon": [
                    {
                      "width": "15px"
                    }
                  ],
                  "grid": [
                    {
                      "grid-template-rows": "1fr",
                      "align-items": "center",
                      "align-content": "center"
                    }
                  ]
                },
                "card_mod": {
                  "style": "ha-card {\n  backdrop-filter: blur(10px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(10px) saturate(160%) !important;\n}\n"
                }
              }
            }
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i n toggle\"",
                "grid-template-columns": "40px 1fr min-content"
              }
            ],
            "card": [
              {
                "background": "transparent",
                "padding": "8px 4px",
                "border-radius": "0px",
                "display": "[[[ const list = variables.var_light_list; if (!list) return 'block'; return list.some(e => states[e] && states[e].state === 'on') ? 'block' : 'none'; ]]]"
              }
            ],
            "name": [
              {
                "font-weight": "550",
                "font-size": "15px",
                "justify-self": "start",
                "color": "white",
                "letter-spacing": "-0.01em"
              }
            ],
            "img_cell": [
              {
                "width": "30px",
                "height": "30px",
                "border-radius": "12px",
                "background-color": "[[[ return variables.var_color ]]]",
                "margin-right": "6px"
              }
            ],
            "icon": [
              {
                "width": "16px",
                "color": "white"
              }
            ],
            "custom_fields": {
              "toggle": [
                {
                  "justify-self": "end",
                  "align-self": "center"
                }
              ]
            }
          }
        },
        "shortcut_tile": {
          "variables": {
            "var_name": null,
            "var_icon": null,
            "var_gradient": "linear-gradient(135deg, rgba(255,255,255,0.10), rgba(255,255,255,0.02))"
          },
          "type": "custom:button-card",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "[[[ return variables.var_icon ]]]",
          "show_name": true,
          "show_icon": true,
          "show_state": false,
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i\" \"n\"",
                "grid-template-rows": "26px min-content",
                "align-content": "center",
                "justify-items": "start"
              }
            ],
            "card": [
              {
                "background": "[[[ return variables.var_gradient ]]]",
                "border-radius": "18px",
                "height": "74px",
                "padding": "12px",
                "justify-content": "start",
                "justify-items": "start",
                "border": "1px solid rgba(255,255,255,0.08)"
              }
            ],
            "icon": [
              {
                "width": "24px",
                "height": "24px",
                "color": "white"
              }
            ],
            "name": [
              {
                "font-size": "13px",
                "font-weight": "550",
                "color": "white",
                "justify-self": "start",
                "padding-top": "7px",
                "letter-spacing": "-0.01em"
              }
            ],
            "img_cell": [
              {
                "width": "26px",
                "height": "26px",
                "justify-self": "start",
                "align-self": "center"
              }
            ]
          },
          "card_mod": {
            "style": "ha-card {\n  backdrop-filter: blur(20px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(20px) saturate(160%) !important;\n}\n"
          }
        },
        "weather_widget": {
          "type": "custom:button-card",
          "entity": "weather.forecast_casa",
          "show_name": false,
          "show_icon": true,
          "show_state": false,
          "tap_action": {
            "action": "more-info"
          },
          "custom_fields": {
            "temp": {
              "card": {
                "type": "custom:button-card",
                "show_name": true,
                "show_icon": false,
                "name": "[[[ return Math.round(states['weather.forecast_casa'].attributes.temperature) + '°'; ]]]",
                "styles": {
                  "card": [
                    {
                      "background": "transparent",
                      "padding": "0px",
                      "height": "auto"
                    }
                  ],
                  "name": [
                    {
                      "font-size": "48px",
                      "font-weight": "600",
                      "color": "white"
                    }
                  ]
                }
              }
            },
            "cond": {
              "card": {
                "type": "custom:button-card",
                "show_name": true,
                "show_icon": false,
                "name": "[[[ return states['weather.forecast_casa'].state; ]]]",
                "styles": {
                  "card": [
                    {
                      "background": "transparent",
                      "padding": "0px"
                    }
                  ],
                  "name": [
                    {
                      "font-size": "15px",
                      "color": "rgba(255,255,255,0.7)",
                      "text-transform": "capitalize"
                    }
                  ]
                }
              }
            }
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"icon temp\" \"icon cond\"",
                "grid-template-columns": "min-content 1fr"
              }
            ],
            "card": [
              {
                "background": "transparent",
                "height": "130px",
                "padding": "10px"
              }
            ],
            "icon": [
              {
                "width": "72px",
                "color": "white"
              }
            ],
            "custom_fields": {
              "temp": [
                {
                  "justify-self": "start"
                }
              ],
              "cond": [
                {
                  "justify-self": "start"
                }
              ]
            }
          }
        },
        "device_tile": {
          "variables": {
            "var_name": null,
            "var_icon": "mdi:lightbulb",
            "var_color": "#FF9F0A"
          },
          "type": "custom:button-card",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "[[[ return variables.var_icon ]]]",
          "show_name": true,
          "show_icon": true,
          "show_state": true,
          "tap_action": {
            "action": "toggle"
          },
          "hold_action": {
            "action": "more-info"
          },
          "state": [
            {
              "value": "off",
              "styles": {
                "card": [
                  {
                    "background": "transparent"
                  }
                ],
                "icon": [
                  {
                    "color": "rgba(255,255,255,0.35)"
                  }
                ],
                "name": [
                  {
                    "color": "rgba(255,255,255,0.6)"
                  }
                ],
                "state": [
                  {
                    "color": "rgba(255,255,255,0.4)"
                  }
                ]
              }
            },
            {
              "value": "on",
              "styles": {
                "card": [
                  {
                    "background": "[[[ return variables.var_color ]]]"
                  }
                ],
                "icon": [
                  {
                    "color": "white"
                  }
                ],
                "name": [
                  {
                    "color": "white"
                  }
                ],
                "state": [
                  {
                    "color": "rgba(255,255,255,0.85)"
                  }
                ]
              }
            }
          ],
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i\" \"n\" \"s\"",
                "grid-template-rows": "min-content min-content min-content"
              }
            ],
            "card": [
              {
                "border-radius": "20px",
                "height": "108px",
                "padding": "14px",
                "justify-content": "start",
                "justify-items": "start",
                "border": "1px solid rgba(255,255,255,0.1)"
              }
            ],
            "icon": [
              {
                "width": "26px"
              }
            ],
            "name": [
              {
                "font-size": "14px",
                "font-weight": "550",
                "padding-top": "10px",
                "justify-self": "start",
                "letter-spacing": "-0.01em"
              }
            ],
            "state": [
              {
                "font-size": "12px",
                "justify-self": "start"
              }
            ]
          },
          "card_mod": {
            "style": "ha-card {\n  backdrop-filter: blur(20px) saturate(160%) !important;\n  -webkit-backdrop-filter: blur(20px) saturate(160%) !important;\n}\n"
          }
        },
        "sensor_tile": {
          "variables": {
            "var_name": null,
            "var_icon": "mdi:gauge",
            "var_color": "#0A84FF"
          },
          "type": "custom:button-card",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "[[[ return variables.var_icon ]]]",
          "show_name": true,
          "show_icon": true,
          "show_state": true,
          "tap_action": {
            "action": "more-info"
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i\" \"n\" \"s\"",
                "grid-template-rows": "24px min-content min-content",
                "align-content": "center",
                "justify-items": "start"
              }
            ],
            "card": [
              {
                "background": "rgba(255,255,255,0.05)",
                "border-radius": "18px",
                "height": "80px",
                "padding": "10px 12px",
                "border": "1px solid rgba(255,255,255,0.08)",
                "justify-content": "start",
                "justify-items": "start"
              }
            ],
            "icon": [
              {
                "width": "22px",
                "height": "22px",
                "color": "[[[ return variables.var_color ]]]"
              }
            ],
            "name": [
              {
                "font-size": "13px",
                "font-weight": "600",
                "color": "white",
                "padding-top": "5px",
                "justify-self": "start",
                "text-align": "left"
              }
            ],
            "state": [
              {
                "font-size": "12.5px",
                "color": "rgba(255,255,255,0.6)",
                "justify-self": "start",
                "text-align": "left",
                "padding-top": "1px"
              }
            ],
            "img_cell": [
              {
                "width": "24px",
                "height": "24px",
                "justify-self": "start",
                "align-self": "center"
              }
            ]
          }
        },
        "now_playing": {
          "variables": {
            "var_entity": null,
            "var_icon": "mdi:television"
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_entity ]]]",
          "show_name": false,
          "show_icon": false,
          "show_state": false,
          "tap_action": {
            "action": "more-info"
          },
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"art info\"",
                "grid-template-columns": "72px 1fr",
                "grid-template-rows": "1fr",
                "align-items": "center",
                "align-content": "center"
              }
            ],
            "card": [
              {
                "height": "98px",
                "padding": "13px",
                "overflow": "hidden"
              }
            ]
          },
          "custom_fields": {
            "art": {
              "card": {
                "type": "custom:button-card",
                "show_icon": true,
                "show_entity_picture": true,
                "entity_picture": "[[[ const s = states[variables.var_entity]; return (s && s.attributes.entity_picture) ? s.attributes.entity_picture : ''; ]]]",
                "icon": "[[[ return variables.var_icon ]]]",
                "styles": {
                  "card": [
                    {
                      "background": "rgba(255,255,255,0.06)",
                      "border-radius": "14px",
                      "height": "72px",
                      "width": "72px",
                      "padding": "0px"
                    }
                  ],
                  "icon": [
                    {
                      "width": "30px",
                      "color": "rgba(255,255,255,0.5)"
                    }
                  ],
                  "entity_picture": [
                    {
                      "border-radius": "16px",
                      "width": "100%",
                      "height": "100%",
                      "object-fit": "cover"
                    }
                  ]
                }
              }
            },
            "info": {
              "card": {
                "type": "custom:button-card",
                "show_name": true,
                "show_label": true,
                "show_icon": false,
                "name": "[[[ const s = states[variables.var_entity]; return (s && s.attributes.media_title) ? s.attributes.media_title : (s && s.state === 'on' ? 'Ligado' : 'Nada tocando'); ]]]",
                "label": "[[[ const s = states[variables.var_entity]; return (s && (s.attributes.media_artist || s.attributes.app_name || s.attributes.source)) || ''; ]]]",
                "styles": {
                  "card": [
                    {
                      "background": "transparent",
                      "padding": "0px 0px 0px 13px",
                      "justify-self": "start",
                      "justify-content": "start"
                    }
                  ],
                  "grid": [
                    {
                      "justify-items": "start",
                      "grid-template-rows": "1fr",
                      "align-content": "center"
                    }
                  ],
                  "name": [
                    {
                      "font-size": "17px",
                      "font-weight": "700",
                      "color": "white",
                      "justify-self": "start",
                      "white-space": "normal",
                      "text-align": "left"
                    }
                  ],
                  "label": [
                    {
                      "font-size": "13px",
                      "color": "rgba(255,255,255,0.6)",
                      "justify-self": "start",
                      "margin-top": "4px"
                    }
                  ]
                }
              }
            }
          }
        },
        "light_row": {
          "variables": {
            "var_name": null,
            "var_entity": null
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_entity ]]]",
          "name": "[[[ return variables.var_name ]]]",
          "icon": "mdi:lightbulb",
          "show_name": true,
          "show_icon": true,
          "show_state": false,
          "tap_action": {
            "action": "toggle"
          },
          "state": [
            {
              "value": "off",
              "styles": {
                "icon": [
                  {
                    "color": "rgba(255,255,255,0.35)"
                  }
                ],
                "name": [
                  {
                    "color": "rgba(255,255,255,0.6)"
                  }
                ]
              }
            },
            {
              "value": "on",
              "styles": {
                "icon": [
                  {
                    "color": "#FF9F0A"
                  }
                ],
                "name": [
                  {
                    "color": "white"
                  }
                ]
              }
            }
          ],
          "styles": {
            "grid": [
              {
                "grid-template-areas": "\"i n toggle\"",
                "grid-template-columns": "36px 1fr min-content",
                "align-items": "center",
                "grid-template-rows": "1fr",
                "align-content": "center"
              }
            ],
            "card": [
              {
                "background": "transparent",
                "padding": "10px 6px 10px 4px",
                "border-radius": "0px"
              }
            ],
            "name": [
              {
                "font-weight": "500",
                "font-size": "14px",
                "justify-self": "start"
              }
            ],
            "icon": [
              {
                "width": "20px"
              }
            ],
            "custom_fields": {
              "toggle": [
                {
                  "justify-self": "end",
                  "align-self": "center"
                }
              ]
            }
          },
          "custom_fields": {
            "toggle": {
              "card": {
                "type": "custom:button-card",
                "entity": "[[[ return variables.var_entity ]]]",
                "icon": "mdi:power",
                "show_name": false,
                "show_icon": true,
                "show_state": false,
                "tap_action": {
                  "action": "toggle"
                },
                "state": [
                  {
                    "value": "off",
                    "styles": {
                      "card": [
                        {
                          "background-color": "transparent"
                        }
                      ],
                      "icon": [
                        {
                          "color": "rgba(255,255,255,0.35)"
                        }
                      ]
                    }
                  },
                  {
                    "value": "on",
                    "styles": {
                      "card": [
                        {
                          "background": "#FF9F0A"
                        }
                      ],
                      "icon": [
                        {
                          "color": "white"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "card": [
                    {
                      "width": "32px",
                      "height": "32px",
                      "border-radius": "100%",
                      "padding": "0px"
                    }
                  ],
                  "icon": [
                    {
                      "width": "15px"
                    }
                  ],
                  "grid": [
                    {
                      "grid-template-rows": "1fr",
                      "align-items": "center",
                      "align-content": "center"
                    }
                  ]
                }
              }
            }
          }
        },
        "room_tile": {
          "variables": {
            "var_name": null,
            "var_path": "/",
            "var_motion": null,
            "var_temp": null,
            "var_sensor": null,
            "var_lights": []
          },
          "type": "custom:button-card",
          "entity": "[[[ return variables.var_motion ]]]",
          "name": "[[[ return variables.var_name ]]]",
          "show_icon": false,
          "show_name": true,
          "show_state": false,
          "tap_action": {
            "action": "navigate",
            "navigation_path": "[[[ return variables.var_path ]]]"
          },
          "custom_fields": {
            "one": {
              "card": {
                "type": "custom:button-card",
                "entity": "[[[ return variables.var_sensor ]]]",
                "icon": "mdi:lightbulb",
                "show_name": false,
                "show_state": true,
                "show_icon": true,
                "tap_action": {
                  "action": "call-service",
                  "service": "[[[ const l = variables.var_lights || []; const algumaAcesa = l.some(e => states[e] && states[e].state === 'on'); return algumaAcesa ? 'homeassistant.turn_off' : 'homeassistant.turn_on'; ]]]",
                  "data": {
                    "entity_id": "[[[ return variables.var_lights ]]]"
                  }
                },
                "state": [
                  {
                    "value": "0",
                    "styles": {
                      "card": [
                        {
                          "background-color": "rgba(255,255,255,0.10)"
                        }
                      ],
                      "icon": [
                        {
                          "color": "rgba(255,255,255,0.45)"
                        }
                      ]
                    }
                  },
                  {
                    "value": "unavailable",
                    "styles": {
                      "card": [
                        {
                          "background": "transparent"
                        }
                      ],
                      "icon": [
                        {
                          "color": "transparent"
                        }
                      ],
                      "state": [
                        {
                          "color": "transparent"
                        }
                      ]
                    }
                  }
                ],
                "styles": {
                  "grid": [
                    {
                      "grid-template-areas": "\"i s\"",
                      "align-items": "center",
                      "grid-template-columns": "14px 1fr",
                      "gap": "3px",
                      "grid-template-rows": "1fr",
                      "align-content": "center",
                      "justify-content": "center"
                    }
                  ],
                  "icon": [
                    {
                      "width": "12px",
                      "color": "white",
                      "padding-left": "2px"
                    }
                  ],
                  "state": [
                    {
                      "color": "white",
                      "font-size": "12px",
                      "justify-self": "start",
                      "padding-right": "5px",
                      "font-weight": "600"
                    }
                  ],
                  "card": [
                    {
                      "height": "25px",
                      "width": "42px",
                      "background-color": "#ff9800",
                      "padding": "0px 4px",
                      "border-radius": "6px",
                      "display": "[[[ return variables.var_sensor ? 'grid' : 'none' ]]]"
                    }
                  ],
                  "img_cell": [
                    {
                      "width": "14px",
                      "height": "14px"
                    }
                  ]
                },
                "card_mod": {
                  "style": "ha-card { border: none !important; box-shadow: none !important; backdrop-filter: none !important; }\nha-card::before, ha-card::after { display: none !important; }"
                }
              }
            },
            "two": {
              "card": {
                "type": "custom:button-card",
                "entity": "[[[ return variables.var_motion ]]]",
                "icon": "mdi:motion-sensor-off",
                "show_name": false,
                "show_state": false,
                "show_icon": true,
                "state": [
                  {
                    "value": "on",
                    "icon": "mdi:motion-sensor",

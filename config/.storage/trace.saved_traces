                    "sequence": [
                      {
                        "action": "light.turn_off",
                        "target": {
                          "entity_id": "{{ ['light.circulacao_switch_1', 'light.painel']\n   | select('is_state', 'on') | list }}"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },

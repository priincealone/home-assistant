                "to": "off",
                "for": "00:10:00",
                "id": "vazio"
              }
            ],
            "conditions": [],
            "actions": [
              {
                "choose": [
                  {
                    "alias": "Movimento com o sol abaixo do horizonte \u2014 acende",

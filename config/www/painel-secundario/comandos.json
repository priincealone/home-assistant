    "tv_sala": {
      "entityId": "media_player.tv_un65du8000gxzd",
      "dominio": "media_player",
      "nome": "TV Sala",
      "comodo": "sala_de_estar",
      "acoes": {
        "ligar": {
          "servico": "media_player.turn_on",
          "confirmaMs": 30000,
          "timeoutMs": 45000
        },
        "desligar": {
          "servico": "media_player.turn_off",
          "somenteSe": {
            "estadoNaoEm": [
              "off",
              "standby",
              "unavailable",
              "unknown"
            ]
          },
          "confirmaMs": 20000,
          "timeoutMs": 30000
        },
        "volume": {
          "servico": "media_player.volume_set",
          "alvo": "tv_nuvem",
          "params": {
            "volume_level": {
              "tipo": "num",
              "min": 0,
              "max": 1
            }
          }
        },
        "mudo": {
          "servico": "media_player.volume_mute",
          "alvo": "tv_nuvem",
          "params": {
            "is_volume_muted": {
              "tipo": "bool"
            }
          }
        },
        "fonte": {
          "servico": "media_player.select_source",
          "params": {
            "source": {
              "tipo": "texto",
              "max": 32,
              "padrao": "^[A-Za-z0-9 ._-]+$"
            }
          }
        },
        "abrirApp": {
          "servico": "media_player.play_media",
          "fixos": {
            "media_content_type": "app"
          },
          "params": {
            "media_content_id": {
              "tipo": "texto",
              "max": 64,
              "padrao": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "controleRemoto": {
          "servico": "remote.send_command",
          "alvo": "tv_remote",
          "params": {
            "command": {
              "tipo": "enum",
              "valores": [
                "KEY_RETURN",
                "KEY_HOME",
                "KEY_MENU",
                "KEY_UP",
                "KEY_DOWN",
                "KEY_LEFT",
                "KEY_RIGHT",
                "KEY_ENTER",
                "KEY_REWIND",
                "KEY_PLAY",
                "KEY_PAUSE",
                "KEY_STOP",
                "KEY_FF"
              ]
            }
          }
        }
      }
    },
    "ps5_sala": {

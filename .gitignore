# Banco de dados e logs do HA (grandes e voláteis)
# (o segundo padrão pega as cópias de conflito do Google Drive, "home-assistant_v2 (1).db-wal")
config/home-assistant_v2.db*
config/home-assistant_v2*.db*
config/*.log
config/*.log.*
config/*.fault
config/.ha_run.lock

# Segredos e credenciais
config/secrets.yaml
config/.storage/auth
config/.storage/auth_provider.homeassistant
config/.storage/http.auth
config/.cloud/
config/google_drive_service_account.json

# Clipes de movimento das câmeras, buffer temporário local antes do upload
config/www/clipes_movimento/

# Caches e dependências
config/deps/
config/.cache/
config/tts/
config/www/community/
config/custom_components/hacs/
config/.storage/hacs.*
config/.storage/core.restore_state
config/.storage/bluetooth.*

# Backups do lovelace (histórico local, não versionado)
backups/

# Bytecode Python
__pycache__/
*.pyc

# Credenciais de integrações (tokens, api keys de dispositivos)
config/.storage/core.config_entries
config/.storage/sonoff/
config/.storage/onboarding
config/.storage/person
# Xiaomi: token da nuvem, OAuth access_token, chave privada e tokens locais dos aparelhos.
# Removidos de todo o histórico em 08/10/2026, antes da primeira publicação no GitHub.
config/.storage/xiaomi_miot/auth-*.json
config/.storage/xiaomi_home/cert/
config/.storage/xiaomi_home/miot_config/
config/.storage/xiaomi_home/miot_devices/

# Dados do container Music Assistant (biblioteca, cache, credenciais)
music-assistant/

# Dados do servidor anisette (provisionamento da "máquina" Apple)
anisette/

# Ferramentas de agente instaladas na pasta (não são configuração da casa)
.agents/
.claude/skills/
skills-lock.json

# Projeto paralelo (interface propria em Next.js, desenvolvida no Antigravity).
# Tem repositorio git proprio desde 07/09/2026 -- o que acontece la nao entra no
# historico da casa. Os commits anteriores a essa data continuam neste historico.
dashboard-app/

# lixo temporario do cliente do Google Drive sincronizando a pasta
.tmp.driveupload/
.tmp.drivedownload/

# Marcadores de pasta criados pelo cliente do Google Drive
desktop.ini
**/desktop.ini
